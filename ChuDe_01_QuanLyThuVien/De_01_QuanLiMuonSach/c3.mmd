%% De_01 - Câu 3: MVC Class Diagram cho module Quản lí việc mượn sách
classDiagram
    class FrmMenu {
        -btnChoMuonSach: Button
        +moFrmMuonSach(): void
    }

    class FrmMuonSach {
        -txtMaVachBanDoc: TextField
        -txtMaVachSach: TextField
        -tblSachDangMuon: Table
        -tblSachDaTra: Table
        -tblSachMuonMoi: Table
        -btnSubmit: Button
        -controller: MuonSachController
        +quetTheBanDoc(): void
        +quetSachMuon(): void
        +submitMuonSach(): void
        +hienThiThongTinBanDoc(banDoc: BanDoc): void
        +hienThiDanhSachSach(dsDangMuon: List~ChiTietMuon~, dsDaTra: List~ChiTietMuon~): void
        +moFrmPhieuMuon(phieuMuon: PhieuMuon): void
    }

    class FrmPhieuMuon {
        -controller: MuonSachController
        -lblMaBanDoc: Label
        -lblTenBanDoc: Label
        -lblMaVachBanDoc: Label
        -lblMaVachPhieuMuon: Label
        -tblSachConMuon: Table
        -lblTongSoSach: Label
        -btnInPhieu: Button
        +hienThiPhieuMuon(phieuMuon: PhieuMuon): void
        +inPhieuMuon(): void
    }

    class MuonSachController {
        -banDocDAO: BanDocDAO
        -dauSachDAO: DauSachDAO
        -phieuMuonDAO: PhieuMuonDAO
        -chiTietMuonDAO: ChiTietMuonDAO
        +xuLyQuetTheBanDoc(maVach: String): BanDoc
        +xuLyQuetSach(maVach: String): DauSach
        +kiemTraGioiHan(maBanDoc: String, soMuonMoi: Integer): Boolean
        +lapPhieuMuon(banDoc: BanDoc, dsSach: List~DauSach~): PhieuMuon
    }

    class BanDocDAO {
        +getByMaVach(maVach: String): BanDoc
    }

    class DauSachDAO {
        +getByMaVach(maVach: String): DauSach
        +updateSoLuong(dauSach: DauSach): void
    }

    class PhieuMuonDAO {
        +insert(phieuMuon: PhieuMuon): void
    }

    class ChiTietMuonDAO {
        +getSachDangMuon(maBanDoc: String): List~ChiTietMuon~
        +getSachDaTra(maBanDoc: String): List~ChiTietMuon~
        +countSachDangMuon(maBanDoc: String): Integer
        +insertAll(ds: List~ChiTietMuon~): void
    }

    class BanDoc {
        -maBanDoc: String
        -tenBanDoc: String
        -ngaySinh: Date
        -diaChi: String
        -soDienThoai: String
        -maVach: String
    }

    class DauSach {
        -maDauSach: String
        -tenSach: String
        -tacGia: String
        -namXuatBan: Integer
        -giaBia: Double
        -soLuong: Integer
        -maVach: String
        -moTa: String
    }

    class PhieuMuon {
        -maPhieuMuon: String
        -banDoc: BanDoc
        -dsChiTietMuon: List~ChiTietMuon~
        -maVachPhieuMuon: String
        -ngayLap: Date
        -tongSoSach: Integer
    }

    class ChiTietMuon {
        -maChiTiet: String
        -dauSach: DauSach
        -ngayMuon: Date
        -ngayPhaiTra: Date
        -ngayTra: Date
    }

    FrmMenu -- FrmMuonSach
    FrmMuonSach -- FrmPhieuMuon

    FrmMuonSach o-- MuonSachController : controller
    FrmPhieuMuon o-- MuonSachController : controller
    MuonSachController o-- BanDocDAO : banDocDAO
    MuonSachController o-- DauSachDAO : dauSachDAO
    MuonSachController o-- PhieuMuonDAO : phieuMuonDAO
    MuonSachController o-- ChiTietMuonDAO : chiTietMuonDAO

    BanDocDAO -- BanDoc : traVe
    DauSachDAO -- DauSach : traVe
    PhieuMuonDAO -- PhieuMuon : traVe
    ChiTietMuonDAO -- ChiTietMuon : traVe

    BanDoc "1" -- "0..*" PhieuMuon : banDoc
    PhieuMuon "1" -- "1..5" ChiTietMuon : dsChiTietMuon
    DauSach "1" -- "0..*" ChiTietMuon : dauSach
