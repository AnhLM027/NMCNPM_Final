%% De_55 - Câu 3: MVC Class Diagram cho module Thống kê khung giờ được thuê nhiều
classDiagram
    class FrmMenu {
        -btnThongKeKhungGioThueNhieu: Button
        +moFrmThongKeKhungGioThueNhieu(): void
    }

    class FrmThongKeKhungGioThueNhieu {
        -controller: ThongKeKhungGioController
        -dtNgayBatDau: DatePicker
        -dtNgayKetThuc: DatePicker
        -tblKhungGio: Table
        -tblBuoiThueSan: Table
        -btnThongKe: Button
        +chonNgayBatDau(ngayBatDau: Date): void
        +chonNgayKetThuc(ngayKetThuc: Date): void
        +clickThongKe(): void
        +clickChonKhungGio(khungGio: String, ngay: Date): void
        +hienThiBangKhungGio(dsThongKe: List~ThongKeKhungGioDTO~): void
        +hienThiBuoiThueSan(dsBuoiThue: List~BuoiThueSanDTO~): void
        +hienThiThongBao(message: String): void
    }

    class ThongKeKhungGioController {
        -buoiThueSanDAO: BuoiThueSanDAO
        +layThongKeKhungGio(ngayBatDau: Date, ngayKetThuc: Date): List~ThongKeKhungGioDTO~
        +layBuoiThueTheoKhungGio(khungGio: String, ngay: Date): List~BuoiThueSanDTO~
    }

    class BuoiThueSanDAO {
        +getThongKeKhungGio(ngayBatDau: Date, ngayKetThuc: Date): List~ThongKeKhungGioDTO~
        +getChiTietTheoKhungGio(khungGio: String, ngay: Date): List~BuoiThueSanDTO~
        +getByKhungGioVaNgay(khungGio: String, ngay: Date): List~BuoiThueSan~
    }

    class ThongKeKhungGioDTO {
        -khungGio: String
        -ngay: Date
        -tongSoLuotThue: Integer
        -tongTienThuDuoc: Double
    }

    class BuoiThueSanDTO {
        -maPhieuDat: String
        -tenKhachHang: String
        -tenSan: String
        -ngayGio: DateTime
        -gia: Double
        -tongTien: Double
    }

    class SanMini {
        -maSan: String
        -tenSan: String
        -loaiSan: String
        -giaThueMotBuoi: Double
    }

    class KhachHang {
        -maKhachHang: String
        -tenKhachHang: String
        -soDienThoai: String
    }

    class PhieuDatSan {
        -maPhieuDat: String
        -khachHang: KhachHang
        -ngayLamHopDong: Date
        -thongTinChuSan: String
        -soTienDatCoc: Double
        -ngayDatCoc: Date
        -tongTienThueDuKien: Double
        -dsChiTietDatSan: List~ChiTietDatSan~
    }

    class ChiTietDatSan {
        -sanMini: SanMini
        -giaThueMotBuoi: Double
        -khungGioThueTrongTuan: String
        -ngayBatDau: Date
        -ngayKetThuc: Date
        -tongSoBuoi: Integer
        -tongTienDuKien: Double
        -dsBuoiThueSan: List~BuoiThueSan~
    }

    class BuoiThueSan {
        -chiTietDatSan: ChiTietDatSan
        -ngayThue: Date
        -khungGio: String
    }

    class HoaDonThanhToan {
        -maHoaDon: String
        -phieuDatSan: PhieuDatSan
        -ngayThanhToan: Date
        -tongTienSan: Double
        -tongTienHang: Double
        -tongTienThanhToan: Double
    }

    FrmMenu -- FrmThongKeKhungGioThueNhieu

    FrmThongKeKhungGioThueNhieu o-- ThongKeKhungGioController : controller
    ThongKeKhungGioController o-- BuoiThueSanDAO : buoiThueSanDAO

    BuoiThueSanDAO -- BuoiThueSan : traVe
    BuoiThueSanDAO -- ThongKeKhungGioDTO : traVe
    BuoiThueSanDAO -- BuoiThueSanDTO : traVe

    SanMini "0..*" -- "0..1" SanMini : sanGhep
    KhachHang "1" -- "0..*" PhieuDatSan : khachHang
    PhieuDatSan "1" o-- "1..*" ChiTietDatSan : dsChiTietDatSan
    SanMini "1" -- "0..*" ChiTietDatSan : sanMini
    ChiTietDatSan "1" o-- "1..*" BuoiThueSan : dsBuoiThueSan
    PhieuDatSan "1" o-- "0..1" HoaDonThanhToan : hoaDonThanhToan
