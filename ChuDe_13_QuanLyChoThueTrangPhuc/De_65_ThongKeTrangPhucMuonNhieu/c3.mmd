        +getByTrangPhuc(maTrangPhuc: String, ngayBatDau: Date, ngayKetThuc: Date): List~ChiTietThue~
    }

    class ChiTietTraDAO {
        +getByTrangPhuc(maTrangPhuc: String, ngayBatDau: Date, ngayKetThuc: Date): List~ChiTietTra~
    }

    class ThongKeTrangPhucDTO {
        -maTrangPhuc: String
        -tenTrangPhuc: String
        -kieu: String
        -tongSoLuotMuon: Integer
        -tongTienThuDuoc: Double
    }

    class PhieuTrangPhucDTO {
