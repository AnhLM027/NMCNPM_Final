        -khachHang: KhachHang
        -ngayThue: Date
        -tienCoc: Double
        -dsChiTietThue: List~ChiTietThue~
    }

    class ChiTietThue {
        -trangPhuc: TrangPhuc
        -soLuong: Integer
        -soLuongDaTra: Integer
        -donGiaThue: Double
    }

    class PhieuTra {
        -maPhieuTra: String
        -khachHang: KhachHang
        -ngayTra: Date
        -tongTienThue: Double
        -tongTienPhat: Double
        -soTienKhachPhaiTra: Double
        -soTienTraLaiKhach: Double
