classDiagram
    class FrmMenu {
        -btnThongKeTrangPhucMuonNhieu: Button
        +moFrmThongKeTrangPhucMuonNhieu(): void
    }

    class FrmThongKeTrangPhucMuonNhieu {
        -controller: ThongKeTrangPhucMuonNhieuController
        -dtNgayBatDau: DatePicker
        -dtNgayKetThuc: DatePicker
        -tblTrangPhuc: Table
        -tblHoaDonChiTiet: Table
