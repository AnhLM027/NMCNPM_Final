        +tinhTongTienThuDuoc(dsChiTietTra: List~ChiTietTra~): Double
    }

    class ChiTietThueDAO {
        +getThongKeTrangPhucMuonNhieu(ngayBatDau: Date, ngayKetThuc: Date): List~ThongKeTrangPhucDTO~
