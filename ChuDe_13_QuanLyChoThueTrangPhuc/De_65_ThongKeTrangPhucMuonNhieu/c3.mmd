        -ngayGioTra: Date
        -tongTien: Double
    }

    class KhachHang {
        -maKhachHang: String
        -tenKhachHang: String
        -soDienThoai: String
        -diaChi: String
    }

    class TrangPhuc {
        -maTrangPhuc: String
        -tenTrangPhuc: String
        -kieu: String
        -soLuong: Integer
        -giaTriGoc: Double
        -giaThue: Double
    }

    class PhieuThue {
