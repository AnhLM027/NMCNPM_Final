    KhachHang "1" -- "0..*" PhieuThue : thuê
    KhachHang "1" -- "0..*" PhieuTra : trả đồ
    PhieuThue "1" *-- "1..*" ChiTietThue : gồm
    ChiTietThue "0..*" -- "1" TrangPhuc : trang phục
    PhieuTra "1" *-- "1..*" ChiTietTra : gồm
